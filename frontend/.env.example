# Backend API URL (use for production deployment)
# Vite uses VITE_ prefix; if you use Create React App use REACT_APP_BACKEND_URL
VITE_API_URL=http://localhost:5000/api
# Production example:
# VITE_API_URL=https://your-backend.onrender.com/api

# Razorpay Key ID (Test mode first, then Live)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
