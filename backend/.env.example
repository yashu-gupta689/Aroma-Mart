# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas (use aromamart_db as database name)
# Local: mongodb://localhost:27017/aromamart_db
# Atlas: mongodb+srv://aromamart_admin:<password>@cluster0.xxxxx.mongodb.net/aromamart_db
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/aromamart_db

# JWT
JWT_SECRET=<secure_random_string>
JWT_EXPIRE=7d

# Cloudinary (product images, brand logos, banners)
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Razorpay (Test mode first, then Live)
RAZORPAY_KEY_ID=xxxx
RAZORPAY_SECRET=xxxx

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Commission percentage
COMMISSION_PERCENTAGE=15
